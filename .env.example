# BELONG environment configuration.
# Copy to .env.local for local overrides. NOTHING here is required to run locally:
# with no variables set, BELONG uses a local SQLite file, the simulated
# companion, simulated payments and seeded fictional demo members.
# Never commit real values. See INTEGRATION_CHECKLIST.md for each service.

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, used in links inside emails. Read at runtime.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "false" in production: no demo accounts are seeded, demo sign-in buttons and
# simulated replies from fictional members are disabled.
BELONG_DEMO_MODE=true

# ── Database ─────────────────────────────────────────────────────────────────
# Local development: SQLite file (default ./data/belong.db).
# DATABASE_FILE=./data/belong.db
# Production: PostgreSQL / Supabase connection string. When set, SQLite is not used.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Set to "false" to stop the app applying migrations on start (run `npm run db:migrate` instead).
# BELONG_AUTO_MIGRATE=true

# ── AI companion (Claude) ────────────────────────────────────────────────────
# When set, the companion uses Claude instead of the built-in simulation.
# ANTHROPIC_API_KEY=
# BELONG_CLAUDE_MODEL=claude-opus-5-5
# Force the simulation even when a key is present:
# BELONG_AI_PROVIDER=mock

# ── Payments (Stripe) — adapter to be completed, see INTEGRATION_CHECKLIST.md ─
# BELONG_PAYMENTS_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PLUS=
# STRIPE_PRICE_PREMIUM=

# ── Scheduled agent-network run ──────────────────────────────────────────────
# Enables POST /api/cron/network (Authorization: Bearer <secret>).
# CRON_SECRET=

# ── Integration points not yet wired (adapters exist) ────────────────────────
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM="BELONG <hello@your-domain>"
# PUSH_API_KEY=
# EMBEDDINGS_API_KEY=
# MAPS_API_KEY=
# STORAGE_BUCKET=

# ── Tests ────────────────────────────────────────────────────────────────────
# Opt-in PostgreSQL test. Must be an EMPTY, disposable database (its schema is dropped).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/belong_test
